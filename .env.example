# Optional runtime overrides. The desktop app recommends an ASR model automatically.
LINGUA_MODEL=large-v3-turbo
LINGUA_DEVICE=auto
LINGUA_COMPUTE_TYPE=float16
LINGUA_CPU_THREADS=8
LINGUA_TRANSLATOR=auto
LINGUA_PYTHON=

# Optional local Ollama translation.
LINGUA_OLLAMA_URL=http://127.0.0.1:11434
LINGUA_OLLAMA_MODEL=

# Optional OpenAI-compatible cloud translation endpoint.
LINGUA_LLM_URL=
LINGUA_LLM_API_KEY=
LINGUA_LLM_MODEL=

# Optional model download/cache settings.
LINGUA_MODEL_SOURCE=modelscope
LINGUA_MODEL_DIR=
LINGUA_HF_ENDPOINT=https://hf-mirror.com
LINGUA_PRELOAD_MODEL=1
LINGUA_PRELOAD_TRANSLATOR=1
